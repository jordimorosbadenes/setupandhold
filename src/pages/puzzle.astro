---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/withBase';
---

<BaseLayout
  title="Puzzle Studio"
  description="Genera puzzles 3D, visualiza soluciones y descarga STL listo para imprimir."
  bgMode="pieces"
>
  <section class="hero">
    <div class="hero-copy prose">
      <h1>PuzzleStudio3D</h1>
      <p>
        Genera y personaliza puzzles 3D: elige el tipo de puzzle, personaliza en el editor de texturas, y exporta de manera flexible a STL/3MF listo para impresión.
      </p>
      <div class="hero-actions">
        <button class="button button--soon" disabled data-tooltip="La página estará lista pronto" id="btn-studio">Abrir Puzzle Studio</button>
        <a class="button" href={withBase('/')}>Ir al inicio</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .button--soon {
    position: relative;
    cursor: default;
    opacity: 0.5;
    font: inherit;
    padding: 10px 16px;
    border: 1px solid var(--border);
    background: linear-gradient(120deg, rgba(124, 242, 201, 0.16), rgba(108, 177, 255, 0.08));
    width: auto;
  }
  .tt-studio {
    position: fixed;
    z-index: 9999;
    pointer-events: none;
    background: var(--card);
    color: var(--text);
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 0.85rem;
    white-space: nowrap;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
  }
</style>
<script is:inline>
  (() => {
    const btn = document.getElementById('btn-studio');
    if (!btn) return;
    let tt = null;
    btn.addEventListener('mouseenter', () => {
      tt = document.createElement('div');
      tt.className = 'tt-studio';
      tt.textContent = btn.getAttribute('data-tooltip');
      document.body.appendChild(tt);
    });
    btn.addEventListener('mousemove', (e) => {
      if (!tt) return;
      const x = e.clientX + 12;
      const y = e.clientY + 12;
      tt.style.left = x + 'px';
      tt.style.top = y + 'px';
    });
    btn.addEventListener('mouseleave', () => {
      if (tt) { tt.remove(); tt = null; }
    });
  })();
</script>
