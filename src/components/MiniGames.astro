---
import Mini2048 from './mini2048/Mini2048.astro';
import MiniWordle from './miniwordle/MiniWordle.astro';
import MiniPips from './minipips/MiniPips.astro';

const {
  storageKey = 'mini-2048-state-v2',
  apiBase = (import.meta as any).env?.PUBLIC_LEADERBOARD_URL ?? '',
} = Astro.props;
---

<div class="mg">
  <!-- ── Header ─────────────────────────────────────────────── -->
  <div class="mg__header">
    <h2 class="mg__section-title">Minijuegos</h2>

    <!-- Tab selector -->
    <div class="mg__tabs" role="tablist" aria-label="Selector de minijuego">
      <button
        class="mg__tab mg__tab--active"
        data-mg-tab="0"
        role="tab"
        aria-selected="true"
        aria-controls="mg-panel-0"
        type="button"
      >2048</button>
      <button
        class="mg__tab"
        data-mg-tab="1"
        role="tab"
        aria-selected="false"
        aria-controls="mg-panel-1"
        type="button"
      >Wordle</button>
      <button
        class="mg__tab"
        data-mg-tab="2"
        role="tab"
        aria-selected="false"
        aria-controls="mg-panel-2"
        type="button"
      >Pips</button>
    </div>
  </div>

  <!-- ── Game panels ────────────────────────────────────────── -->
  <div id="mg-panel-0" class="mg__panel" data-mg-panel="0" role="tabpanel">
    <Mini2048 storageKey={storageKey} apiBase={apiBase} />
  </div>

  <div id="mg-panel-1" class="mg__panel mg__panel--hidden" data-mg-panel="1" role="tabpanel">
    <MiniWordle />
  </div>

  <div id="mg-panel-2" class="mg__panel mg__panel--hidden" data-mg-panel="2" role="tabpanel">
    <MiniPips />
  </div>
</div>

<style>
  .mg {
    display: grid;
    gap: 12px;
  }

  /* ── Header ─────────────────────────────── */
  .mg__header {
    display: grid;
    gap: 8px;
  }

  .mg__section-title {
    margin: 0;
    letter-spacing: -0.02em;
  }

  /* ── Tabs ────────────────────────────────── */
  .mg__tabs {
    display: flex;
    gap: 6px;
  }

  .mg__tab {
    flex: 1;
    padding: 8px 10px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    text-align: center;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .mg__tab:hover {
    background: var(--bg-soft);
    color: var(--text);
  }

  .mg__tab--active {
    background: color-mix(in srgb, var(--accent) 10%, var(--card));
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    color: var(--text);
  }

  /* ── Panels ──────────────────────────────── */
  .mg__panel {
    /* Visible by default — no extra styles needed */
  }

  .mg__panel--hidden {
    display: none;
  }
</style>

<script is:inline>
  (() => {
    const root = document.querySelector('.mg');
    if (!root || root.dataset.mgInit === '1') return;
    root.dataset.mgInit = '1';

    const STORAGE_KEY = 'minigames-active-v1';
    const panels    = Array.from(root.querySelectorAll('[data-mg-panel]'));
    const tabs      = Array.from(root.querySelectorAll('[data-mg-tab]'));
    const total     = panels.length;

    // Restore last active game
    let current = 0;
    try {
      const saved = parseInt(localStorage.getItem(STORAGE_KEY) || '0', 10);
      if (saved >= 0 && saved < total) current = saved;
    } catch {}

    const goTo = (idx) => {
      current = ((idx % total) + total) % total;

      panels.forEach((p, i) => {
        const hidden = i !== current;
        p.classList.toggle('mg__panel--hidden', hidden);
        p.setAttribute('aria-hidden', String(hidden));
      });

      tabs.forEach((t, i) => {
        const active = i === current;
        t.classList.toggle('mg__tab--active', active);
        t.setAttribute('aria-selected', String(active));
      });

      try { localStorage.setItem(STORAGE_KEY, String(current)); } catch {}
    };

    // Init without animation
    goTo(current);

    // Tab clicks
    tabs.forEach((tab, i) => tab.addEventListener('click', () => goTo(i)));


    // ── Swipe navigation ────────────────────────────────────────────────
    // Only fires when the touch does NOT start on the 2048 board or wordle keyboard
    // (those elements handle their own pointer events).
    let sx = null;
    let sy = null;

    root.addEventListener('pointerdown', (e) => {
      if (e.target.closest('[data-board]') || e.target.closest('.mw__kbd')) return;
      sx = e.clientX;
      sy = e.clientY;
    });

    root.addEventListener('pointerup', (e) => {
      if (sx === null) return;
      const dx = e.clientX - sx;
      const dy = e.clientY - sy;
      sx = null;
      // Require a clear horizontal swipe (> 70 px, more horizontal than vertical)
      if (Math.abs(dx) > 70 && Math.abs(dx) > Math.abs(dy) * 1.5) {
        goTo(dx < 0 ? current + 1 : current - 1);
      }
    });

    root.addEventListener('pointercancel', () => { sx = null; });
  })();
</script>
